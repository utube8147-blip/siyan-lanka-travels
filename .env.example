# ---------------------------------------------------------------- public ----
NEXT_PUBLIC_SITE_URL=https://www.siyanlanka.lk
# Hotline shown on the site (call button, tickets, help). Empty = buttons hidden.
NEXT_PUBLIC_HOTLINE=
# WhatsApp number for the chat button (optional; defaults to the hotline)
NEXT_PUBLIC_WHATSAPP=

# Supabase (Project Settings → API). Leave empty to run in demo mode.
# Publishable (or legacy "anon") key only. NEVER the secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: Web Push public key (README → Notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ----------------------------------------------- server only (never NEXT_PUBLIC) ----
# Supabase secret key: used by /api routes (payments, message sending).
SUPABASE_SECRET_KEY=
# Notify.lk: booking & trip text messages only (not sign-in codes; those are
# sent by Supabase via MessageBird, set up in the Supabase dashboard).
# https://app.notify.lk → Settings → API Keys
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=NotifyDEMO
# WhatsApp Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=siyan_update
WHATSAPP_TEMPLATE_LANG=en
# PayHere (https://www.payhere.lk → Integrations)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
# Public address PayHere calls back (defaults to NEXT_PUBLIC_SITE_URL)
PAYHERE_NOTIFY_BASE=
# Protects /api/messages/dispatch (any long random string)
CRON_SECRET=

# Web Push private key (pair of NEXT_PUBLIC_VAPID_PUBLIC_KEY; `npx web-push generate-vapid-keys`).
# Needed for reminders when the app is closed. Server only.
VAPID_PRIVATE_KEY=
# Contact address push services can use, e.g. mailto:you@example.com (optional)
VAPID_SUBJECT=

# The owner's mobile number. Gets the code that releases a reserved seat
# (Staff area → Buses → Reserved seats). Server only, never NEXT_PUBLIC.
OWNER_PHONE=

# TESTING ONLY. When set to 6 digits, booking codes are not texted and this
# code works for every mobile number. Leave EMPTY on the live site.
BOOKING_OTP_TEST_CODE=
